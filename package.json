{
  "name": "Calcux",
  "productName": "Calcux",
  "version": "1.0.0",
  "description": "Calcux...",
  "author": {
    "name": "vexikoff"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir --win",
    "dist": "electron-builder --win",
    "build": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "*",
    "electron-builder": "*"
  },
  "build": {
    "appId": "xyz.vexikoff.calcux",
    "productName": "Calcux",
    "executableName": "Calcux",
    "copyright": "Sunne CL",
    "artifactName": "${name}-${version}-windows-${arch}.${ext}",
    "directories": {
      "buildResources": ".",
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!release/**",
      "!**/*.map",
      "!**/.DS_Store",
      "!node_modules/.cache/**"
    ],
    "extraResources": [
      {
        "from": "assets/logos/logobg.png",
        "to": "assets/logos/logobg.png"
      },
      {
        "from": "assets/logos/logo.ico",
        "to": "assets/logos/logo.ico"
      }
    ],
    "asar": true,
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logos/logo.ico",
      "artifactName": "${name}-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calcux",
      "installerIcon": "assets/logos/logo.ico",
      "uninstallerIcon": "assets/logos/logo.ico",
      "installerHeaderIcon": "assets/logos/logo.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
